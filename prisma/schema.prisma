// Prisma Schema for Personal Life Log Orchestrator
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LifeUser {
  id          String   @id @default(cuid())
  externalId  String?  @unique
  email       String?  @unique
  name        String?
  avatarUrl   String?
  timezone    String   @default("UTC")
  preferences Json     @default("{}")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  eventLogs        EventLog[]
  dailySummaries   DailySummary[]
  weeklyReviews    WeeklyReview[]
  notes            Note[]
  tags             Tag[]
  templates        Template[]
  goals            Goal[]
  habits           Habit[]
  habitEntries     HabitEntry[]
  integrations     Integration[]
  aiPrompts        AIPrompt[]

  @@map("life_users")
}

model EventLog {
  id          String   @id @default(cuid())
  userId      String
  type        String   // calendar, email, expense, note, task, etc.
  source      String   // google_calendar, gmail, manual, etc.
  occurredAt  DateTime
  payloadJson Json     // Flexible JSON storage for event details
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    LifeUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags    EventLogTag[]

  @@index([userId, occurredAt])
  @@index([userId, type])
  @@index([userId, source])
  @@map("event_logs")
}

model Note {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime @db.Date
  title      String?
  content    String   @db.Text
  templateId String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     LifeUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  tags     NoteTag[]

  @@unique([userId, date])
  @@index([userId, date])
  @@index([templateId])
  @@map("notes")
}

model DailySummary {
  id              String   @id @default(cuid())
  date            DateTime @db.Date
  userId          String
  summaryMarkdown String   @db.Text
  moodTag         String?  // happy, neutral, sad, productive, etc.
  highlightsJson  Json     // { goodThings: [], todoTomorrow: [] }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user LifeUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_summaries")
}

model WeeklyReview {
  id              String   @id @default(cuid())
  weekStartDate   DateTime @db.Date // Monday of the week
  userId          String
  summaryMarkdown String   @db.Text
  goalsJson       Json     // { achievements: [], nextWeekGoals: [] }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user LifeUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStartDate])
  @@index([userId, weekStartDate])
  @@map("weekly_reviews")
}
// New entities for Phase 3
// Tags System
model Tag {
  id          String   @id @default(cuid())
  userId      String
  name        String
  color       String?  @default("#6B7280")
  description String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         LifeUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventLogTags EventLogTag[]
  noteTags     NoteTag[]
  goalTags     GoalTag[]

  @@unique([userId, name])
  @@index([userId])
  @@map("tags")
}

model EventLogTag {
  id          String   @id @default(cuid())
  eventLogId  String
  tagId       String
  createdAt   DateTime @default(now())

  eventLog EventLog @relation(fields: [eventLogId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([eventLogId, tagId])
  @@map("event_log_tags")
}

model NoteTag {
  id        String   @id @default(cuid())
  noteId    String
  tagId     String
  createdAt DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([noteId, tagId])
  @@map("note_tags")
}

// Templates System
model Template {
  id          String   @id @default(cuid())
  userId      String
  name        String
  type        String   // note, daily_summary, weekly_review
  content     String   @db.Text
  variables   Json     @default("[]")
  isDefault   Boolean  @default(false)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  LifeUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes Note[]

  @@index([userId, type])
  @@map("templates")
}

// Goals System
model Goal {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?  @db.Text
  status      String   @default("active") // active, completed, archived
  category    String?  // health, career, personal, financial, etc.
  targetDate  DateTime?
  progress    Int      @default(0) // 0-100
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user LifeUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags GoalTag[]

  @@index([userId, status])
  @@index([userId, targetDate])
  @@map("goals")
}

model GoalTag {
  id        String   @id @default(cuid())
  goalId    String
  tagId     String
  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([goalId, tagId])
  @@map("goal_tags")
}

// Habits System
model Habit {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  frequency   String   @default("daily") // daily, weekly, monthly
  target      Int      @default(1) // times per frequency
  unit        String?  // steps, minutes, pages, etc.
  isActive    Boolean  @default(true)
  startDate   DateTime @default(now())
  endDate     DateTime?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    LifeUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries HabitEntry[]

  @@index([userId, isActive])
  @@map("habits")
}

model HabitEntry {
  id        String   @id @default(cuid())
  habitId   String
  userId    String
  date      DateTime @db.Date
  value     Int      @default(1) // completion count or measured value
  note      String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  habit Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  LifeUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
  @@map("habit_entries")
}

// Integrations System
model Integration {
  id             String   @id @default(cuid())
  userId         String
  provider       String   // google, notion, todoist, github, etc.
  isActive       Boolean  @default(true)
  credentials    Json     // Encrypted credentials
  configuration  Json     @default("{}")
  lastSyncAt     DateTime?
  lastSyncStatus String?  // success, error, partial
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user LifeUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId, isActive])
  @@map("integrations")
}

// AI Prompts System
model AIPrompt {
  id          String   @id @default(cuid())
  userId      String
  name        String
  type        String   // daily_summary, weekly_review, custom
  prompt      String   @db.Text
  model       String   @default("gpt-4o-mini")
  temperature Float    @default(0.7)
  isDefault   Boolean  @default(false)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user LifeUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("ai_prompts")
}
